// ==UserScript==
// @name         Mi Reproductor YouTube + Playlist MP3 (Safe JS)
// @namespace    http://tampermonkey.net
// @version      4.0
// @description  Reproductor multimedia en JavaScript puro para evitar errores de sintaxis en Poki
// @match        https://poki.com
// @match        https://poki.com
// @grant        none
// @run-at       document-end
// ==/UserScript==

(function() {
    'use strict';

    // 1. CREACIÓN DINÁMICA DE ESTILOS CSS
    const style = document.createElement('style');
    style.textContent = `
        body { margin: 0; background: linear-gradient(135deg, #020617, #0f172a) !important; color: white !important; font-family: system-ui, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; overflow: hidden; }
        .player-container { background-color: rgba(30, 41, 59, 0.85); backdrop-filter: blur(12px); width: 380px; padding: 25px; border-radius: 24px; box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); text-align: center; z-index: 99999999 !important; position: relative; }
        .album-art { width: 140px; height: 140px; background-color: #ef4444; background-image: radial-gradient(circle, #ef4444, #991b1b); margin: 0 auto 15px auto; border-radius: 50%; box-shadow: 0 10px 25px rgba(239, 68, 68, 0.4); display: flex; align-items: center; justify-content: center; font-size: 50px; transition: transform 0.5s; }
        .playing .album-art { animation: rotateArt 12s linear infinite; }
        @keyframes rotateArt { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .track-title { font-size: 17px; font-weight: 700; margin: 0 0 4px 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: white !important; }
        .track-artist { font-size: 12px; color: #94a3b8 !important; margin: 0 0 15px 0; }
        .yt-box { display: flex; gap: 8px; margin-bottom: 15px; }
        .yt-input { flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid #334155; background: #1e293b; color: white !important; font-size: 12px; outline: none; }
        .yt-btn { padding: 8px 14px; background: #ef4444; border: none; color: white !important; border-radius: 8px; font-weight: bold; font-size: 11px; cursor: pointer; }
        .yt-btn:hover { background: #dc2626; }
        .progress-area { width: 100%; height: 6px; background-color: #475569; border-radius: 10px; cursor: pointer; margin-bottom: 6px; }
        .progress-bar { height: 100%; width: 0%; background: linear-gradient(90deg, #ef4444, #3b82f6); border-radius: 10px; }
        .time-container { display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8 !important; margin-bottom: 15px; }
        .controls { display: flex; justify-content: center; align-items: center; gap: 20px; margin-bottom: 15px; }
        .btn { background: none; border: none; color: white !important; cursor: pointer; font-size: 20px; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
        .btn-main { background-color: white !important; color: #0f172a !important; width: 50px; height: 50px; border-radius: 50%; }
        .playlist-section { text-align: left; background: rgba(15, 23, 42, 0.6); border-radius: 12px; padding: 10px; max-height: 120px; overflow-y: auto; }
        .playlist-title { font-size: 11px; text-transform: uppercase; color: #64748b !important; font-weight: bold; margin: 0 0 6px 0; }
        .song-item { padding: 6px 8px; border-radius: 6px; font-size: 12px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #e2e8f0 !important; }
        .song-item:hover { background: rgba(255,255,255,0.08); }
        .song-item.active-song { background: rgba(239, 68, 68, 0.2); color: #f87171 !important; font-weight: bold; }
    `;
    document.head.appendChild(style);

    // 2. CONSTRUCCIÓN DE LA ESTRUCTURA USANDO CADENAS DE TEXTO SEGURAS
    const container = document.createElement('div');
    container.className = 'player-container';
    container.id = 'player';

    container.innerHTML = [
        '<div class="album-art" id="art">📺</div>',
        '<div class="track-title" id="title">Estación YouTube MP3</div>',
        '<div class="track-artist" id="artist">Pega enlaces de videos musicales</div>',
        '<div class="yt-box">',
        '  <input type="text" id="yt-url" class="yt-input" placeholder="Pega el enlace de YouTube...">',
        '  <button id="yt-download" class="yt-btn">AÑADIR</button>',
        '</div>',
        '<div class="progress-area" id="progress-container"><div class="progress-bar" id="progress"></div></div>',
        '<div class="time-container"><span id="current-time">0:00</span><span id="duration">0:00</span></div>',
        '<div class="controls">',
        '  <button class="btn" id="prev">⏮</button>',
        '  <button class="btn btn-main" id="play">▶</button>',
        '  <button class="btn" id="next">⏭</button>',
        '</div>',
        '<div class="playlist-section">',
        '  <h4 class="playlist-title">Lista de reproducción</h4>',
        '  <div id="playlist-container"></div>',
        '</div>'
    ].join('');

    document.body.innerHTML = ''; 
    document.body.appendChild(container);

    const audio = document.createElement('audio');
    audio.id = 'audio';
    document.body.appendChild(audio);

    // 3. LOGICA OPERATIVA DEL REPRODUCTOR
    const playBtn = document.getElementById('play');
    const prevBtn = document.getElementById('prev');
    const nextBtn = document.getElementById('next');
    const ytUrlInput = document.getElementById('yt-url');
    const ytBtn = document.getElementById('yt-download');
    const progress = document.getElementById('progress');
    const progressContainer = document.getElementById('progress-container');
    const title = document.getElementById('title');
    const artist = document.getElementById('artist');
    const currentTimeEl = document.getElementById('current-time');
    const durationEl = document.getElementById('duration');
    const playlistContainer = document.getElementById('playlist-container');

    let playlist = [];
    let currentIndex = 0;

    ytBtn.addEventListener('click', function() {
        const url = ytUrlInput.value.trim();
        if (!url) return;
        
        // Expresión regular corregida para capturar de forma segura la ID de YouTube
        const regExp = /^.*(?:(?:youtu\.be\/|v\/|vi\/|u\/\w\/|embed\/|shorts\/)|(?:(?:watch)?\?v(?:i)?=|\&v(?:i)?=))([^#\&\?]*).*/;
        const match = url.match(regExp);
        
        if (match && match[1].length === 11) {
            const videoId = match[1];
            artist.innerText = "Procesando pista de YouTube...";
            const audioLink = "https://vexdh.com" + videoId; 
            playlist.push({ name: "YouTube Track (" + videoId + ")", url: audioLink });
            actualizarInterfazPlaylist();
            ytUrlInput.value = '';
            if (!container.classList.contains('playing')) seleccionarCancion(playlist.length - 1);
        } else {
            alert("Ingresa un enlace válido de YouTube.");
        }
    });

    function actualizarInterfazPlaylist() {
        playlistContainer.innerHTML = '';
        playlist.forEach((song, index) => {
            const item = document.createElement('div');
            item.className = 'song-item ' + (index === currentIndex ? 'active-song' : '');
            item.innerText = (index + 1) + '. ' + song.name;
            item.onclick = () => seleccionarCancion(index);
            playlistContainer.appendChild(item);
        });
    }

    function seleccionarCancion(index) {
        if (playlist.length === 0) return;
        currentIndex = index;
        title.innerText = playlist[currentIndex].name;
        artist.innerText = "Streaming de YouTube";
        audio.src = playlist[currentIndex].url;
        actualizarInterfazPlaylist();
        container.classList.add('playing');
        playBtn.innerText = '⏸';
        audio.play().catch(() => { artist.innerText = "Presiona PLAY para iniciar"; });
    }

    playBtn.addEventListener('click', () => {
        if (playlist.length === 0) return;
        if (container.classList.contains('playing')) {
            container.classList.remove('playing'); playBtn.innerText = '▶'; audio.pause();
        } else {
            container.classList.add('playing'); playBtn.innerText = '⏸'; audio.play();
        }
    });

    nextBtn.addEventListener('click', () => {
        if (playlist.length === 0) return;
        currentIndex = (currentIndex + 1) % playlist.length; seleccionarCancion(currentIndex);
    });

    prevBtn.addEventListener('click', () => {
        if (playlist.length === 0) return;
        currentIndex = (currentIndex - 1 + playlist.length) % playlist.length; seleccionarCancion(currentIndex);
    });

    audio.addEventListener('timeupdate', (e) => {
        const { duration, currentTime } = e.srcElement;
        if (!duration) return;
        progress.style.width = (currentTime / duration * 100) + '%';
        let curMins = Math.floor(currentTime / 60), curSecs = Math.floor(currentTime % 60);
        currentTimeEl.innerText = curMins + ':' + (curSecs < 10 ? '0' : '') + curSecs;
        let durMins = Math.floor(duration / 60), durSecs = Math.floor(duration % 60);
        durationEl.innerText = durMins + ':' + (durSecs < 10 ? '0' : '') + durSecs;
    });

    progressContainer.addEventListener('click', function(e) {
        if (!audio.duration) return;
        audio.currentTime = (e.offsetX / this.clientWidth) * audio.duration;
    });

    audio.addEventListener('ended', () => {
        currentIndex = (currentIndex + 1) % playlist.length; seleccionarCancion(currentIndex);
    });

})();
